{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeroclaw-chat",
  "main": "src/index.tsx",
  "compatibility_date": "2026-02-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeroclaw-chat-db",
      "database_id": "placeholder-d1-id"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "placeholder-kv-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "zeroclaw-chat-files"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}